// Shared, re-usable declaration blocks.
// $block  -> a raised card surface (post article, archive card, pagination)
// $base-style -> typography/element rules applied to any "content" area
// (post body AND the Resume / Cheese Party custom pages).

$block-caption
  text-decoration: none
  text-transform: uppercase
  letter-spacing: 2px
  color: var(--color-faint)
  margin-bottom: 1em
  margin-left: 5px
  line-height: 1em
  font-weight: 600

$block
  background: var(--color-surface)
  box-shadow: var(--shadow-1)
  border: 1px solid var(--color-border)
  border-radius: 10px

$base-style
  h1
    font-size: font-title
    line-height: 1.25
    font-weight: 700
    margin: 1.1em 0 0.6em
  h2
    font-size: font-h2
    font-weight: 700
    margin: 1.6em 0 0.6em
    line-height: 1.3
  h3
    font-size: font-h3
    font-weight: 600
    margin: 1.4em 0 0.5em
    line-height: 1.35
  h4
    font-size: font-h4
    font-weight: 600
    margin: 1.2em 0 0.5em
    line-height: 1.4
  h5
    font-size: 1em
    font-weight: 600
    margin: 1em 0 0.5em
  h6
    font-size: 1em
    color: var(--color-muted)
    margin: 1em 0 0.5em
  hr
    border: 0
    border-top: 1px solid var(--color-border)
    margin: 1.5em 0
  strong
    font-weight: 700
  em, cite
    font-style: italic
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
  ul, ol, dl
    margin: 0 1.2em
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: 600
  a:focus-visible
    outline: 2px solid var(--color-accent)
    outline-offset: 2px
    border-radius: 2px
