@import "nib"
@import "_variables"
@import "_util/mixin"
@import "_util/grid"

// ============================================================
// Palette — light + dark. Every surface/ink/border is a CSS
// custom property so dark mode is a [data-theme] swap.
// The "space" motif: light mode is a soft off-white with a
// calm space-blue accent; dark mode is a deep navy, not black.
// ============================================================
:root
  color-scheme: light dark
  --color-bg: #f4f6fa
  --color-surface: #ffffff
  --color-surface-2: #e9edf4
  --color-text: #1b2230
  --color-muted: #5a6478
  --color-faint: #8a93a6
  --color-border: #dde3ee
  --color-border-strong: #c3cbdc
  --color-accent: #3f6fd6
  --color-accent-strong: #2c55b8
  --color-accent-soft: #e5edff
  --color-footer-bg: #141926
  --color-footer-text: #c7cdd9
  --color-code-bg: #eef1f7
  --shadow-1: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.1)
  --shadow-2: 0 6px 20px rgba(16, 24, 40, 0.12)

[data-theme="dark"]
  color-scheme: dark
  --color-bg: #0d1220
  --color-surface: #151b2c
  --color-surface-2: #1d2438
  --color-text: #e6e9f0
  --color-muted: #9aa3b7
  --color-faint: #6f7890
  --color-border: #283149
  --color-border-strong: #38425e
  --color-accent: #84a9ff
  --color-accent-strong: #a9c4ff
  --color-accent-soft: #1a2642
  --color-footer-bg: #0a0e1a
  --color-footer-text: #9aa3b7
  --color-code-bg: #101624
  --shadow-1: 0 1px 2px rgba(0, 0, 0, 0.4)
  --shadow-2: 0 8px 24px rgba(0, 0, 0, 0.5)

global-reset()

input, button, select, textarea
  margin: 0
  padding: 0
  background: transparent
  color: inherit
  &::-moz-focus-inner
    border: 0
    padding: 0

a
  color: var(--color-accent)
  text-underline-offset: 2px

img
  max-width: 100%

html, body, #container
  height: 100%

body
  background: var(--color-bg)
  color: var(--color-text)
  font: font-size/1.75 font-sans
  -webkit-text-size-adjust: 100%
  transition: background-color 0.25s ease, color 0.25s ease

// ------------------------------------------------------------
// Mobile-first layout.
// Base (phone): a single centered column. The desktop sidebar
// is hidden at this width (widgets stack below as "Explore").
// ------------------------------------------------------------
.outer
  clearfix()
  max-width: 100%
  margin: 0 auto
  padding: 0 gutter-width
  @media mq-normal
    max-width: (column-width + gutter-width) * columns + gutter-width
  // XL / large desktop: a noticeably wider gap between the body and the
  // tags/archives sidebar (and more room on the outer edges).
  @media mq-xl
    padding: 0 grid-padding

// On ultrawide screens (>=2400px) cap the whole page at a comfortable
// width so it doesn't stretch edge-to-edge.
.inner
  @media mq-xl
    max-width: 1200px
    margin: 0 auto

// Base: main content spans the full (single) column on phones.
#main
  display: inline
  float: left
  width: 100%

// Sidebar is hidden on phones + tablets. On wide screens it becomes a
// demoted right column; its width and gap are percentages of the .outer,
// so the gutter (set on .outer) scales up cleanly at the xl breakpoint.
#sidebar
  display: none

if sidebar and sidebar isnt bottom
  #sidebar
    @media mq-normal
      display: inline
      float: right
      width: 22.7%
      margin-left: 2.4%   // 5% of outer at xl -> the widened gap
      @media mq-xl
        margin-left: 5%
  #main
    @media mq-normal
      width: 74.9%         // 100% - 22.7% - 2.4% gap
      @media mq-xl
        width: 72.3%       // 100% - 22.7% - 5% gap

if sidebar is left
  @media mq-normal
    #main
      float: right
      width: 74.9%
      @media mq-xl
        width: 72.3%
    #sidebar
      float: left

.inner
  // (kept for API compatibility; width now driven by .inner max-width on xl, above)

.left, .alignleft
  float: left

.right, .alignright
  float: right

.clear
  clear: both

#container
  position: relative

.mobile-nav-on
  overflow: hidden

#wrap
  height: 100%
  width: 100%
  position: absolute
  top: 0
  left: 0
  transition: 0.2s ease-out
  z-index: 1
  background: var(--color-bg)
  .mobile-nav-on &
    left: mobile-nav-width

@import "_extend"
@import "_partial/header"
@import "_partial/article"
@import "_partial/comment"
@import "_partial/archive"
@import "_partial/footer"
@import "_partial/highlight"
@import "_partial/mobile"

if sidebar
  @import "_partial/sidebar"

// Respect reduced-motion preferences.
@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    transition: none !important
    animation: none !important
