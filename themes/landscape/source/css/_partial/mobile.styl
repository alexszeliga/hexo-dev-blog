// Mobile off-canvas navigation drawer (<= 479px).
@media mq-mobile
  #mobile-nav
    position: absolute
    top: 0
    left: 0
    width: mobile-nav-width
    height: 100%
    background: var(--color-surface)
    border-right: 1px solid var(--color-border)
    z-index: 100

@media mq-mobile
  .mobile-nav-link
    display: block
    color: var(--color-muted)
    text-decoration: none
    padding: 16px 24px
    font-weight: 600
    &:hover, &:focus
      color: var(--color-text)
      background: var(--color-surface-2)
