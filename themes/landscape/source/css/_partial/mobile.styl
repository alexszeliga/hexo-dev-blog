// Mobile (<= 479px): an off-canvas nav. Hidden by default (pushed off the
// left edge) and revealed when #container has .mobile-nav-on. The :scope
// combinators ensure ONLY #wrap is pushed and ONLY this nav (a direct
// child of #container, not a child of #wrap) is moved.
#mobile-nav
  position: absolute
  top: 0
  left: -320px
  width: mobile-nav-width
  height: 100%
  background: var(--color-surface)
  border-right: 1px solid var(--color-border)
  z-index: 2
  transition: 0.2s ease-out
  // Reveal: slide the nav into view when the (sibling) wrap is pushed off.
  // :scope = #container (which holds .mobile-nav-on); > = only the nav,
  // which is a direct child of #container (not of #wrap), so the wrap-push
  // above doesn't drag it off-screen.
  #container.mobile-nav-on > &
    left: 0

#mobile-nav-close
  position: absolute
  top: 12px
  right: 16px
  background: none
  border: none
  color: var(--color-faint)
  font-size: 18px
  cursor: pointer
  &:hover, &:focus
    color: var(--color-text)

@media mq-mobile
  .mobile-nav-link
    display: block
    color: var(--color-muted)
    text-decoration: none
    padding: 56px 24px 16px
    font-weight: 600
    &:hover, &:focus
      color: var(--color-text)
      background: var(--color-surface-2)
