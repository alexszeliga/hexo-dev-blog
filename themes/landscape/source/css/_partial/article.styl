.article
  margin: block-margin 0

.article-inner
  @extend $block
  overflow: hidden

.article-meta
  clearfix()

.article-date
  @extend $block-caption
  float: left

.article-category
  float: left
  line-height: 1em
  color: var(--color-faint)
  margin-left: 8px
  &:before
    content: "\2022"

.article-category-link
  @extend $block-caption
  color: var(--color-faint)
  margin: 0 12px 1em
  &:hover
    color: var(--color-accent)

.article-header
  padding: article-padding article-padding 0

.article-title
  text-decoration: none
  font-size: font-title
  font-weight: 700
  color: var(--color-text)
  line-height: line-height-title
  letter-spacing: -0.01em
  transition: color 0.2s
  a&:hover
    color: var(--color-accent)

.article-entry
  @extend $base-style
  clearfix()
  color: var(--color-text)
  padding: 0 article-padding
  p, table
    line-height: line-height
    margin: 1.1em 0
  h1, h2, h3, h4, h5, h6
    font-weight: bold
  h1, h2, h3, h4, h5, h6
    line-height: line-height-title
    margin: 1.2em 0 0.6em
    color: var(--color-text)
  a
    color: var(--color-accent)
    text-decoration: none
    text-underline-offset: 3px
    &:hover
      text-decoration: underline
      color: var(--color-accent-strong)
  ul, ol, dl
    margin-top: 1em
    margin-bottom: 1em
  img, video
    max-width: 100%
    height: auto
    display: block
    margin: auto
    border-radius: 6px
  iframe
    border: none
  table
    width: 100%
    border-collapse: collapse
    border-spacing: 0
  th
    font-weight: 600
    border-bottom: 2px solid var(--color-border-strong)
    padding-bottom: 0.5em
  td
    border-bottom: 1px solid var(--color-border)
    padding: 10px 8px
  blockquote
    font-family: font-serif
    margin: 1.2em 20px
    text-align: center
    color: var(--color-muted)
    footer
      font-size: font-size
      margin: 1em 0
      font-family: font-sans
      cite
        &:before
          content: "—"
          padding: 0 0.5em
  .pullquote
    text-align: left
    width: 45%
    margin: 0
    &.left
      margin-left: 0.5em
      margin-right: 1em
    &.right
      margin-right: 0.5em
      margin-left: 1em
  .caption
    color: var(--color-faint)
    display: block
    font-size: 0.9em
    margin-top: 0.5em
    position: relative
    text-align: center
  // http://webdesignerwall.com/tutorials/css-elastic-videos
  .video-container
    position: relative
    padding-top: (9 / 16 * 100)% // 16:9 ratio
    height: 0
    overflow: hidden
    iframe, object, embed
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      margin-top: 0

.article-more-link a
  display: inline-block
  line-height: 1em
  padding: 8px 18px
  border-radius: 999px
  background: var(--color-accent-soft)
  color: var(--color-accent)
  text-decoration: none
  font-weight: 600
  &:hover
    background: var(--color-accent)
    color: #fff

.article-footer
  clearfix()
  font-size: 0.9em
  line-height: line-height
  border-top: 1px solid var(--color-border)
  padding-top: 1em
  margin: 1.5em article-padding article-padding
  a
    color: var(--color-muted)
    text-decoration: none
    &:hover
      color: var(--color-accent)

.article-tag-list-item
  float: left
  margin-right: 10px

.article-tag-list-link
  &:before
    content: "#"

.article-comment-link
  float: right
  &:before
    padding-right: 8px

.article-share-link
  cursor: pointer
  float: right
  margin-left: 20px
  &:before
    padding-right: 6px

#article-nav
  clearfix()
  position: relative
  @media mq-normal
    margin: block-margin 0
    &:before
      absolute-center(8px)
      content: ""
      border-radius: 50%
      background: var(--color-border-strong)

.article-nav-link-wrap
  text-decoration: none
  color: var(--color-muted)
  box-sizing: border-box
  margin-top: block-margin
  text-align: center
  display: block
  &:hover
    color: var(--color-accent)
  @media mq-normal
    width: 50%
    margin-top: 0

#article-nav-newer
  @media mq-normal
    float: left
    text-align: right
    padding-right: 20px

#article-nav-older
  @media mq-normal
    float: right
    text-align: left
    padding-left: 20px

.article-nav-caption
  text-transform: uppercase
  letter-spacing: 2px
  color: var(--color-faint)
  line-height: 1em
  font-weight: 600
  #article-nav-newer &
    margin-right: -2px

.article-nav-title
  font-size: 0.95em
  line-height: line-height
  margin-top: 0.5em

.article-share-box
  position: absolute
  display: none
  background: var(--color-surface)
  box-shadow: var(--shadow-2)
  border: 1px solid var(--color-border)
  border-radius: 8px
  margin-left: -145px
  overflow: hidden
  z-index: 1
  &.on
    display: block

.article-share-input
  width: 100%
  background: none
  box-sizing: border-box
  font: 14px font-sans
  padding: 0 15px
  color: var(--color-text)
  outline: none
  border: 1px solid var(--color-border)
  border-radius: 3px 3px 0 0
  height: 36px
  line-height: 36px

.article-share-links
  clearfix()
  background: var(--color-surface-2)

$article-share-link
  width: 50px
  height: 36px
  display: block
  float: left
  position: relative
  color: var(--color-muted)
  .fa
    font-size: 20px
    absolute-center(@font-size)
    text-align: center
  &:hover
    background: var(--color-surface-2)
  .fa:hover, &:hover .fa
    color: #fff

.article-share-twitter
  @extend $article-share-link
  &:hover
    background: color-twitter

.article-share-facebook
  @extend $article-share-link
  &:hover
    background: color-facebook

.article-share-pinterest
  @extend $article-share-link
  &:hover
    background: color-pinterest

.article-share-linkedin
  @extend $article-share-link
  &:hover
    background: color-linkedin

.article-gallery
  background: #05070f
  position: relative

.article-gallery-photos
  position: relative
  overflow: hidden

.article-gallery-img
  display: none
  max-width: 100%
  &:first-child
    display: block
  &.loaded
    position: absolute
    display: block
  img
    display: block
    max-width: 100%
    margin: 0 auto
