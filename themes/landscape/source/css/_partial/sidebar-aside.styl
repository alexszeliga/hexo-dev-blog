// Mobile-first: on phones + tablets the widgets render as a quiet
// single-column "Explore" block below the content. On wide screens the
// aside becomes the demoted right sidebar column.
#sidebar
  @media mq-mobile
    display: block
    clear: both
    margin-top: space-4

  @media mq-tablet
    display: block
    clear: both
    margin-top: space-4

  @media mq-normal
    display: inline
    float: right

.widget-wrap
  margin: 0 0 space-2
  // On desktop the whole .outer is offset (see style.styl) so the first
  // widget's title lines up with the post date; cancel its top margin.
  // (The mobile/tablet `margin` shorthand below re-sets it there.)
  &:first-child
    margin-top: 0
  @media mq-mobile
    margin: 0 0 space-4
  @media mq-tablet
    margin: 0 0 space-4
  @media mq-normal
    margin: 0 0 space-4

.widget-title
  @extend $block-caption
  font-size: 0.78em

.widget
  color: var(--color-muted)
  background: var(--color-surface)
  border: 1px solid var(--color-border)
  box-shadow: var(--shadow-1)
  padding: 16px 18px
  border-radius: 10px
  a
    color: var(--color-accent)
    text-decoration: none
    text-underline-offset: 2px
    &:hover
      text-decoration: underline
  ul, ol, dl
    margin: 0
    padding: 0
    ul, ol, dl
      margin-left: 15px
      list-style: disc

.tagcloud
  a
    margin-right: 5px
    display: inline-block
