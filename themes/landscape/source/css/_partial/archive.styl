.archives-wrap
  margin: block-margin 0

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1em

.archive-year
  @extend $block-caption
  font-size: font-h3

.archives
  column-gap: 24px
  @media mq-tablet
    column-count: 2
  @media mq-normal
    column-count: 3

.archive-article
  avoid-column-break()

.archive-article-inner
  @extend $block
  padding: 20px 22px
  margin-bottom: 18px
  transition: transform 0.15s ease, box-shadow 0.15s ease

.archive-article:hover
  .archive-article-inner
    transform: translateY(-2px)
    box-shadow: var(--shadow-2)

.archive-article-title
  text-decoration: none
  font-size: font-h4
  font-weight: 700
  color: var(--color-text)
  line-height: 1.35
  transition: color 0.2s
  &:hover
    color: var(--color-accent)

.archive-article-footer
  margin-top: 0.8em
  color: var(--color-faint)
  font-size: 0.85em

.archive-article-date
  color: var(--color-faint)
  text-decoration: none
  font-size: 0.85em
  line-height: 1em
  margin-bottom: 0.5em
  display: block

#page-nav
  clearfix()
  margin: block-margin auto
  background: var(--color-surface)
  box-shadow: var(--shadow-1)
  border: 1px solid var(--color-border)
  border-radius: 10px
  text-align: center
  color: var(--color-muted)
  overflow: hidden
  a, span
    padding: 12px 22px
    line-height: 1
    height: 2ex
  a
    color: var(--color-muted)
    text-decoration: none
    &:hover
      background: var(--color-surface-2)
      color: var(--color-text)
  .prev
    float: left
  .next
    float: right
  .page-number
    display: inline-block
    @media mq-mobile
      display: none
  .current
    color: var(--color-text)
    font-weight: 700
  .space
    color: var(--color-border-strong)
